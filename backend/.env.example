# Plantilla de configuracion local para el backend.
#
# 1. Copia este archivo y nombralalo .env.
# 2. Reemplaza los valores de ejemplo por los de tu equipo.
# 3. No subas el archivo .env a Git: contiene datos sensibles.

# Django
# -----------------------------------------------------------------------------
# Genera una clave propia para cada entorno. Nunca uses esta clave en produccion.
SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA
# True solo para desarrollo local. En produccion debe ser False.
DEBUG=True

# -----------------------------------------------------------------------------
# Base de datos MySQL
# -----------------------------------------------------------------------------
DB_NAME=topher_db
DB_USER=root
DB_PASSWORD=TU_CONTRASENA_MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306

# Duracion de los tokens en minutos y dias, respectivamente.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# URL donde se ejecuta el frontend. Se usa para los enlaces de recuperacion.
FRONTEND_URL=http://localhost:5173

# Para Gmail, activa la verificacion en dos pasos y crea una contrasena de
# aplicacion de 16 caracteres. No uses la contrasena normal de Gmail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USER=topherproducciones.app@gmail.com
EMAIL_PASS=PEGA_AQUI_LA_CONTRASENA_DE_APLICACION
EMAIL_TIMEOUT=15

# Estas variables las utiliza backend/create_admin.py.
DJANGO_ADMIN_USERNAME=admin_topher
DJANGO_ADMIN_EMAIL=admin@topherproducciones.com
DJANGO_ADMIN_PASSWORD=AdminTopher@2026
